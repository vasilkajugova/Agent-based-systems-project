__pycache__/
*.py[cod]
.venv/
venv/
.idea/
.env

# зачувани тежини на мрежата (регенерираат се со train.py, не се
# намерно версионирани - оригиналниот upload исто така не ги вклучуваше)
*.pt

# checkpoint-и "во тек" (train.py::run_training ги презапишува на секои
# checkpoint_every епизоди, за crash-recovery) - со паралелно стартување
# (experiments/parallel.py) ги има по еден за секој (метод, seed) job,
# премногу шум за да се версионираат. Само финалниот *_history.json
# (по завршен тренинг) е она што навистина влегува во извештајот.
*_history_partial.json
*_checkpoint_agent*.pt

# сурови runtime-логови од стартување во background (пр. `... *> results/x.log`) -
# самиот текст на логот е само тековен принт-излез, не резултат сам по
# себе - вистинските резултати секогаш се структурираните *.json фајлови.
results/*.log
